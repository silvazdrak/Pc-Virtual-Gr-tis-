
name: PC Virtual Ubuntu Desktop

on:
  workflow_dispatch:

jobs:
  desktop:
    runs-on: ubuntu-24.04
    timeout-minutes: 360

    steps:
      - name: Instalar ambiente gráfico
        run: |
          sudo apt update
          sudo apt install -y \
            xfce4 \
            xfce4-terminal \
            dbus-x11 \
            xvfb \
            x11vnc \
            novnc \
            websockify \
            wget

      - name: Iniciar Ubuntu Desktop
        env:
          DESKTOP_PASSWORD: ${{ secrets.DESKTOP_PASSWORD }}
        run: |
          if [ "${#DESKTOP_PASSWORD}" -ne 8 ]; then
            echo "Configure DESKTOP_PASSWORD com exatamente 8 caracteres."
            exit 1
          fi

          Xvfb :0 -screen 0 1280x800x24 &
          sleep 3

          export DISPLAY=:0
          dbus-launch --exit-with-session startxfce4 &

          x11vnc -storepasswd "$DESKTOP_PASSWORD" /tmp/vnc.pass
          x11vnc -display :0 \
            -rfbauth /tmp/vnc.pass \
            -forever -shared \
            -rfbport 5900 -localhost &

          sleep 5

      - name: Configurar acesso pelo navegador
        run: |
          websockify \
            --web=/usr/share/novnc/ \
            6080 localhost:5900 &

          wget -q \
            https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb \
            -O /tmp/cloudflared.deb

          sudo dpkg -i /tmp/cloudflared.deb

      - name: Abrir conexão
        run: |
          cloudflared tunnel \
            --url http://localhost:6080 \
            --no-autoupdate > /tmp/tunnel.log 2>&1 &

          for i in $(seq 1 60); do
            URL=$(grep -o 'https://[-a-z0-9]*\.trycloudflare\.com' /tmp/tunnel.log | head -n 1)

            if [ -n "$URL" ]; then
              echo "================================"
              echo "PC VIRTUAL INICIADO!"
              echo "================================"
              echo "ACESSE:"
              echo "${URL}/vnc.html?autoconnect=true&resize=scale&path=websockify"
              break
            fi

            sleep 2
          done

          if [ -z "$URL" ]; then
            cat /tmp/tunnel.log
            exit 1
          fi

          while true; do sleep 300; done
          
